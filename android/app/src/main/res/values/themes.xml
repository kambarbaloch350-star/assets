<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.JadooyeAdad" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>

    <!-- Shown for the few hundred ms before the WebView paints, so the app
         never flashes white on a cold start. -->
    <style name="Theme.JadooyeAdad.Splash" parent="Theme.JadooyeAdad">
        <item name="android:windowBackground">@drawable/splash_bg</item>
    </style>
</resources>
